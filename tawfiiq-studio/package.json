{
  "name": "tawfiiq-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for the Tawfiiq Group website",
  "type": "module",
  "scripts": {
    "dev": "sanity dev --port 3333",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "node seed/build-seed.ts",
    "import:new": "sanity dataset import seed/content.ndjson --dataset trade-group-dataset --missing",
    "import": "sanity dataset import seed/content.ndjson --dataset trade-group-dataset --replace",
    "cleanup": "node seed/remove-old-ids.ts"
  },
  "dependencies": {
    "@sanity/vision": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "latest",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^5.9.0"
  }
}
